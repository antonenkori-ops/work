# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в git не коммитить!

# Базовый URL вашей Jira Server/Data Center, без слэша на конце
JIRA_BASE_URL=https://jira.example.company.com

# Логин и пароль для basic auth
JIRA_USERNAME=your.login
JIRA_PASSWORD=your-password

# JQL-запрос, определяющий, какие задачи синхронизировать.
# По умолчанию — все задачи, назначенные на текущего пользователя.
JIRA_JQL=assignee = currentUser() ORDER BY updated DESC

# Путь к файлу SQLite (можно оставить по умолчанию)
DATABASE_URL=sqlite:///./work_assistant.db
